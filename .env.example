# ---- Database (MUST be a replica set; the app refuses to start otherwise) ----
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_NAME=cde_db

# ---- Keycloak ----
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=cde
KEYCLOAK_CLIENT_ID=cde-api          # backend audience
KEYCLOAK_WEB_CLIENT_ID=cde-web      # browser client (PKCE)

# Passwords for the seed users baked into infra/keycloak/cde-realm.json
# (admin / student1) — read by Dockerfile.keycloak's realm import.
KC_SEED_ADMIN_PASSWORD=
KC_SEED_STUDENT_PASSWORD=

# ---- Gemini (Release B onward; leave blank for Release A) ----
GEMINI_API_KEY=
GEMINI_DIAGNOSTIC_MODEL=gemini-3.1-pro-preview
CDE_VERIFIED_CROP_ROOT=./verified_storage
CDE_DIAGNOSTIC_TIMEOUT_SECONDS=45
