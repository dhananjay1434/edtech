FROM quay.io/keycloak/keycloak:26.0

# Build-time options (baked in by `kc.sh build`). Single instance, so no
# cluster networking: the default ispn/udp stack is what causes the JGroups
# "cookie mismatch" spam when two containers overlap during a deploy.
ENV KC_HEALTH_ENABLED=false
ENV KC_METRICS_ENABLED=false
ENV KC_CACHE=local
ENV KC_HTTP_ENABLED=true
ENV KC_HOSTNAME=https://cde-auth.onrender.com
ENV KC_PROXY_HEADERS=xforwarded
RUN /opt/keycloak/bin/kc.sh build

# The realm is imported at RUNTIME (not baked at build time) because the
# seeded users' passwords are ${env.KC_SEED_*_PASSWORD} placeholders that
# only resolve against the service's runtime environment.
COPY infra/keycloak /opt/keycloak/data/import

ENV JAVA_OPTS_APPEND="-Xms64m -Xmx256m -XX:MetaspaceSize=64m -XX:MaxMetaspaceSize=160m -XX:TieredStopAtLevel=1 -Djava.security.egd=file:/dev/./urandom"
CMD ["start", "--optimized", "--import-realm"]
